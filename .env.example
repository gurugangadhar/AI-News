# ==============================================================================
# Personal AI Engineer Daily Digest - Environment Variables Template
# ==============================================================================
# Copy this file to .env for local execution, or add these keys to:
# GitHub Repository -> Settings -> Secrets and variables -> Actions
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI LLM Provider Configuration
# ------------------------------------------------------------------------------
# Option A: Google Gemini (Recommended)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash

# Option B: Anthropic Claude
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-sonnet-20241022

# Option C: OpenAI / OpenRouter
# LLM_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 2. Email Delivery Configuration
# ------------------------------------------------------------------------------
# Option A: Resend (Recommended)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=Personal AI Digest <onboarding@resend.dev>
EMAIL_TO=your_email@example.com

# Option B: Gmail SMTP / Custom SMTP
# EMAIL_PROVIDER=smtp
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASSWORD=your_16_digit_app_password
# EMAIL_TO=your_email@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ------------------------------------------------------------------------------
# 3. Schedule & Timezone
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
MORNING_DIGEST_TIME=06:00
EVENING_DIGEST_TIME=18:00

# ------------------------------------------------------------------------------
# 4. Pipeline Execution Settings
# ------------------------------------------------------------------------------
DIGEST_TYPE=auto
DRY_RUN=false
NEWS_SUMMARY_STATE=data/state.json
